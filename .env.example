POSTGRES_DB=zenit
POSTGRES_ADMIN_USER=zenit_admin
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
WEB_PORT=8081
KEYCLOAK_PORT=8082
PORTAL_URL=http://localhost:8081
IDENTITY_URL=http://localhost:8082
# Acepta la tarjeta simulada del prototipo. Solo con datos ficticios.
CAPTURE_SIMULATED_CARDS=false
# Minutos durante los que un exporte listo se puede descargar.
EXPORTS_TTL_MINUTES=15
# Atiende los trabajos encolados, como preparar un exporte.
JOBS_ENABLED=true
# Peticiones por minuto que se le aceptan a una persona.
API_PERSON_REQUESTS_PER_MINUTE=600
# Segundos entre revisiones del cierre programado.
CLOSURES_SCHEDULE_CHECK_SECONDS=60
