# Configuración de Zenit en el servidor compartido. No lleva secretos.
IDENTITY_URL=https://zenit.fastsolution.com.mx/id
PORTAL_URL=https://zenit.fastsolution.com.mx
IDENTITY_ADMIN_URL=http://127.0.0.1:19082
BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=19082
ZENIT_SECRETOS=/opt/.fastsolution/zenit/secretos
# Ambiente con datos ficticios: la tarjeta simulada sigue apagada salvo que se
# decida encenderla para probar la app sin tarjetas reales.
CAPTURE_SIMULATED_CARDS=false
