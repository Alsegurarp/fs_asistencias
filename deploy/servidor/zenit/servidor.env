# Configuración de Zenit en el servidor compartido. No lleva secretos.
IDENTITY_URL=https://zenit.fastsolution.com.mx/id
PORTAL_URL=https://zenit.fastsolution.com.mx
# Consola de la identidad: no sale por el borde, se usa por túnel SSH.
IDENTITY_CONSOLE_URL=http://127.0.0.1:19082
# API de administración que usa el backend para el cambio obligatorio de
# contraseña, por la red interna. No es la consola.
IDENTITY_ADMIN_URL=http://keycloak:8082
BIND_ADDRESS=127.0.0.1
KEYCLOAK_PORT=19082
ZENIT_SECRETOS=/opt/.fastsolution/zenit/secretos
# Encendida para conectar la app mientras el servidor no verifica la tarjeta
# real: reconoce cada tarjeta por la huella de su identificador, sin
# autenticarla. Sólo con datos ficticios; se apaga antes de cargar datos de
# personas reales.
CAPTURE_SIMULATED_CARDS=true
