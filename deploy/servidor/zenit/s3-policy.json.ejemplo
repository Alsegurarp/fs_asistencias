{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsultarRetencion",
      "Effect": "Allow",
      "Action": "s3:GetLifecycleConfiguration",
      "Resource": "arn:aws:s3:::BUCKET"
    },
    {
      "Sid": "RespaldarInstancia",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET/zenit/INSTANCE_ID/*"
    }
  ]
}
