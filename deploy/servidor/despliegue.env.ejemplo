# Copia este archivo como deploy/servidor/.env.despliegue y llena los valores.
# Ese archivo no se sube a Git. No lleva llaves ni contraseñas: sólo rutas.

# Directorio privado con el acceso SSH al servidor: config, known_hosts e
# identity. config define el alias de abajo (HostName, User y Port).
FS_SSH_PERFIL=

# Alias del servidor dentro de ese config.
FS_SSH_ALIAS=

# Clon local del repositorio de la landing (sólo para desplegar la landing).
LANDING_REPO=

# Demostración (deploy/servidor/demo/demo.sh). Carpeta local, fuera de Git,
# donde se generan las cuentas, sus QR y la clave de las tarjetas del piloto.
DEMO_SECRETOS=
# Opcionales: coordenadas del lugar donde se presenta, para la sede Matriz
# Centro. Sin ellas queda en el Zócalo de la Ciudad de México.
DEMO_LATITUD=
DEMO_LONGITUD=
