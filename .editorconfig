root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.kt]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 necesita la marca BOM para leer los acentos.
[*.ps1]
charset = utf-8-bom
